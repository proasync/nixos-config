# swaylock — Catppuccin Mocha, Mauve accent (the colors hyprlock used).
# Run through ~/.config/wm-scripts/lock.sh (power menu, idle, before sleep).
# Type the password and press Enter; the ring flashes red on a wrong one.

color=1e1e2e
font=mononoki Nerd Font
indicator-radius=110
indicator-thickness=8
show-failed-attempts
ignore-empty-password
indicator-caps-lock

# Ring: mauve at rest, blue while checking, red when wrong, peach with Caps Lock
ring-color=cba6f7
ring-ver-color=89b4fa
ring-wrong-color=f38ba8
ring-clear-color=f5e0dc
ring-caps-lock-color=fab387
key-hl-color=a6e3a1
bs-hl-color=f38ba8
caps-lock-key-hl-color=a6e3a1
caps-lock-bs-hl-color=f38ba8

inside-color=1e1e2e
inside-ver-color=1e1e2e
inside-wrong-color=1e1e2e
inside-clear-color=1e1e2e
inside-caps-lock-color=1e1e2e

line-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
separator-color=00000000

text-color=cdd6f4
text-ver-color=89b4fa
text-wrong-color=f38ba8
text-clear-color=f5e0dc
text-caps-lock-color=fab387

layout-bg-color=00000000
layout-border-color=00000000
layout-text-color=cdd6f4
