/* Rofi drun launcher for Awesome on X11: launcher.rasi plus bigger sizes on
 * screens 2800 px wide and up, i.e. proasync-laptop's 2880x1800 panel, which
 * X11 does not scale (tuned 2026-04, commit 227486b). 1x desktops never reach
 * this width. Why this is a separate file: see launcher.rasi. */

@import "launcher.rasi"

@media ( min-width: 2800px ) {
    window       { width: 830px; border: 3px; border-radius: 20px; }
    inputbar     { padding: 24px; border-radius: 20px 20px 0 0; }
    prompt       { font: "mononoki Nerd Font 36.667"; padding: 0 14px 0 0; }
    entry        { font: "mononoki Nerd Font 33.333"; }
    listview     { spacing: 6px; padding: 14px; }
    element      { padding: 16px 24px; border-radius: 14px; }
    element-text { font: "mononoki Nerd Font 33.333"; }
    element-icon { size: 40px; padding: 0 16px 0 0; }
}
