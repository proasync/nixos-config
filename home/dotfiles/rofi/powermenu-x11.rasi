/* Rofi power menu for Awesome on X11: powermenu.rasi plus bigger sizes on the
 * laptop's 2880x1800 panel. Separate from powermenu.rasi for the reason given
 * in launcher.rasi. */

@import "powermenu.rasi"

@media ( min-width: 2800px ) {
    prompt       { font: "mononoki Nerd Font Bold 46.667"; }
    entry        { font: "mononoki Nerd Font 40"; }
    element      { padding: 24px 34px; border-radius: 16px; }
    element-text { font: "mononoki Nerd Font 40"; }
}
